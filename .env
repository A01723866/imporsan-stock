# Vite solo expone al cliente variables que empiezan por VITE_

# URL del backend FastAPI
# Desarrollo:  http://localhost:8000
# Producción:  cambiar al dominio donde esté desplegado el backend
VITE_API_URL=http://localhost:8000

# NOTA: Las credenciales de Supabase viven SOLO en el backend
# (backend/.env). El frontend habla con FastAPI, y FastAPI habla con
# Supabase. Nunca poner VITE_SUPABASE_* aquí — expondría las keys al
# navegador.
